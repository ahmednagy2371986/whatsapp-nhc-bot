{
  "name": "whatsapp-nhc-cloud-bot",
  "version": "2.0.0",
  "type": "module",
  "description": "Cloud WhatsApp Bot (Baileys + GitHub Actions) for ليالى NHC الكرويه every Sunday at 1:00 PM sharp",
  "main": "bot.mjs",
  "scripts": {
